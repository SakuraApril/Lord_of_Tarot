# 服务器
PORT=3000
NODE_ENV=production

# 数据库（Vercel Postgres 连接串）
POSTGRES_URL=postgres://user:pass@host:port/db

# Supabase CA 证书（生产环境用，内容为 PEM 格式，可选）
SUPABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# JWT
JWT_SECRET=你的随机密钥（至少32位，用 openssl rand -base64 32 生成）

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 邮件 SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的授权码
SMTP_FROM=你的邮箱@qq.com

# 应用地址
BASE_URL=https://lord-of-tarot.fly.dev
ALLOWED_ORIGIN=https://lord-of-tarot.fly.dev
