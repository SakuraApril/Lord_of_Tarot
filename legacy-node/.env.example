# 服务器
PORT=3000
NODE_ENV=production

# ── MySQL 8.0（原为 Supabase PostgreSQL，迁移说明见 docs/mysql-migration.md）
# 方式一：整串连接地址
MYSQL_URL=mysql://tarot:tarot123@127.0.0.1:3306/tarot
# 方式二：分开写（MYSQL_URL 为空时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tarot
MYSQL_PASSWORD=tarot123
MYSQL_DATABASE=tarot
MYSQL_POOL_SIZE=5

# ── Redis（限流与缓存）
REDIS_URL=redis://127.0.0.1:6379

# ── RabbitMQ（解读任务异步化）
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# JWT
JWT_SECRET=你的随机密钥（至少32位，用 openssl rand -base64 32 生成）

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 邮件 SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的授权码
SMTP_FROM=你的邮箱@qq.com

# 应用地址
BASE_URL=https://lord-of-tarot.fly.dev
ALLOWED_ORIGIN=https://lord-of-tarot.fly.dev
