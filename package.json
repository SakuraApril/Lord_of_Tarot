    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "dev":  "node server.js",
                    "db:init":  "node -e \"require(\u0027./db/init\u0027).initDB().then(()=\u003eprocess.exit(0)).catch(e=\u003e{console.error(e);process.exit(1)})\"",
                    "verify:mysql":  "node scripts/verify_mysql.js",
                    "gen-coupons":  "node scripts/gen-coupons.js",
                    "verify:redis":  "node scripts/verify_redis.js",
                    "verify:degrade":  "node scripts/verify_degrade.js",
                    "worker":  "node workers/reading_worker.js",
                    "verify:async":  "node scripts/verify_async.js",
                    "verify:refund":  "node scripts/verify_refund.js"
                },
